# =============================================================================
# SearchBot — environment configuration
#
# SELF-HOST QUICK START: copy this to `.env`, fill the 3 keys in the REQUIRED
# block + pick an API_KEY, then `docker compose up`. Everything below "HOSTED-ONLY"
# is optional and OFF by default — you do NOT need Supabase to run the engine.
# =============================================================================

# ----------------------------- REQUIRED (engine) -----------------------------
# Web search (solves anti-bot/recaptcha for the search step): https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# Primary LLM: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.5-flash-lite

# Your API key for calling /api/v1/query in self-host mode (choose any strong string).
# Send it as the `X-API-Key` header.
API_KEY=choose_a_long_random_secret

# --------------------------- LLM fallback (optional) -------------------------
# If set, Gemini rate-limits/errors transparently fall over to OpenAI.
# Leave blank to run Gemini-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PRIMARY=gemini
MAX_OUTPUT_TOKENS=8192

# ------------------------------ Retrieval / RAG ------------------------------
MAX_SOURCES=10
# local = MiniLM (free, needs `pip install sentence-transformers`)
# hashing = zero-dependency lexical fallback (no model)
# openai = text-embedding-3-small (needs OPENAI_API_KEY)
EMBEDDING_MODE=local
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOKEN_BUDGET=90000

# --------------------------- Concurrency / scaling ---------------------------
# Reserved concurrent scrape "slots". On a 1-box deploy keep both; on a 2-box
# deploy set the demo box to DEMO_SLOTS only and the signed-in box to SIGNEDIN_SLOTS only.
SIGNEDIN_SLOTS=2
DEMO_SLOTS=1
MEMORY_GUARD_MB=120
BLOCK_RESOURCES=True

# Search engine
SERPAPI_ENGINE=google
SEARCH_RESULTS_LIMIT=10
MAX_PAGES_TO_SCRAPE=10

# Playwright
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_TIMEOUT=30000

# Cache (skip scrape + LLM on repeat queries)
CACHE_ENABLED=True
CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO

# Comma-separated frontend origins allowed to call the backend.
# Production example: CORS_ORIGINS=https://searchbot.live,https://www.searchbot.live
CORS_ORIGINS=*

# =============================================================================
# HOSTED-ONLY (optional) — leave as-is for self-host
# =============================================================================
# Auth: accounts (hosted users + scoped keys) | keystore (admin-managed keys) | static (single API_KEY) | off | supabase
AUTH_MODE=static
QUOTA_ENABLED=False
ANALYTICS_ENABLED=False

# Key store (AUTH_MODE=keystore) — managed via the Developers page (admin-gated)
KEYSTORE_PATH=data/keystore.json
DEFAULT_KEY_QUOTA=0          # 0 = unlimited; per-key quota set at creation
# Hosted account auth (AUTH_MODE=accounts) � users sign in on your own domain.
ACCOUNT_STORE_BACKEND=local        # local | supabase
ACCOUNT_STORE_PATH=data/accounts.json
ACCOUNT_MONTHLY_CREDITS=1000
SESSION_SECRET=change_me_to_a_long_random_secret
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
RESEND_API_KEY=
EMAIL_FROM=SearchBot <onboarding@resend.dev>
AUTH_BRAND_NAME=SearchBot
AUTH_PUBLIC_URL=http://localhost:5173

# Supabase database (server-side only; use service role key, never expose it to frontend)
SUPABASE_URL=
SUPABASE_KEY=

# Admin analytics dashboard (only if ANALYTICS_ENABLED=True)
# Generate the bcrypt hash yourself; never store the plaintext password.
ADMIN_USER=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
